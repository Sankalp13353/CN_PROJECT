    Client -- "3. Insecure HTTP (TCP:80)" --> HTTP_80
    HTTP_80 -- "4. 301 Redirect -> https://..." --> Client

    Client -- "5. Secure HTTPS (TCP:443 + TLS)" --> HTTPS_443
    HTTPS_443 --> RR_LB
